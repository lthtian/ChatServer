+// 发布端 SR 确定采集时刻，观看端 SR 必须使用改写后的 SSRC 和 RTP 时间戳。
+srs_error_t SrsRtcSendTrack::report_packet(SrsRtpPacket* pkt)
+{
+    ++report_packets_;
+    report_bytes_ += pkt->payload() ? pkt->payload()->nb_bytes() : 0;
+    const srs_utime_t now = srs_update_system_time();
+    if (pkt->get_avsync_time() <= 0 || now - report_time_ < SRS_UTIME_SECONDS) {
+        return srs_success;
+    }
+    // NTP 使用 1900 年纪元；按 SDP 时钟频率推算报告发送时刻的 RTP 值。
+    // 不能直接把当前时间与最后一个已采集包的 RTP 值配成一对。
+    const int64_t ntp_ms = now / SRS_UTIME_MILLISECONDS + 2208988800000LL;
+    const int64_t delta = ntp_ms - pkt->get_avsync_time();
+    const int64_t rate = track_desc_->media_->sample_;
+    SrsRtcpSR report;
+    report.set_ssrc(pkt->header.get_ssrc());
+    report.set_ntp(SrsNtp::from_time_ms(ntp_ms).ntp_);
+    report.set_rtp_ts(pkt->header.get_timestamp() + uint32_t(delta * rate / 1000));
+    report.set_rtp_send_packets(report_packets_);
+    report.set_rtp_send_bytes(report_bytes_);
+    char bytes[kRtpPacketSize];
+    SrsBuffer buffer(bytes, sizeof(bytes));
+    srs_error_t err = report.encode(&buffer);
+    if (err != srs_success) return srs_error_wrap(err, "encode sender report");
+    report_time_ = now;
+    // 复用连接的 SRTCP 加密与 UDP 发送，不另外建立连接。
+    return session_->send_rtcp(bytes, buffer.pos());
 }
 
