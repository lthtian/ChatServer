listen 1935;
max_connections 32;
daemon off;
pid __LIVE_ROOT__/srs.pid;
srs_log_tank console;
srs_log_level warn;

http_api {
    enabled on;
    listen 127.0.0.1:1985;
}
http_server {
    enabled on;
    listen 127.0.0.1:8080;
    dir __LIVE_ROOT__;
}
vhost __defaultVhost__ {
    # 播放只接受本机 Nginx 的连接；公网 RTMP 入口仅用于带业务凭证的推流。
    security {
        enabled on;
        allow publish all;
        allow play 127.0.0.1;
    }
    play {
        gop_cache on;
        # 队列需容纳完整的起播 GOP；文件样本的关键帧间隔可能超过三秒。
        queue_length 30;
    }
    http_remux {
        enabled on;
        mount [vhost]/[app]/[stream].flv;
    }
    hls {
        enabled on;
        # 资源授权由 Nginx/业务服务完成，不增加 SRS 的 hls_ctx 会话查询参数。
        hls_ctx off;
        hls_ts_ctx off;
        hls_path __LIVE_ROOT__;
        hls_fragment 2;
        # 音频强制封段的阈值需大于输入 GOP，避免长 GOP 被截成不可独立解码的分片。
        hls_aof_ratio 10;
        hls_window 10;
        hls_cleanup on;
        hls_dispose 30;
        hls_m3u8_file [app]/[stream].m3u8;
        hls_ts_file [app]/[stream]-[seq].ts;
    }
    http_hooks {
        enabled on;
        on_publish http://127.0.0.1:6003/srs?secret=__HOOK_SECRET__;
        on_unpublish http://127.0.0.1:6003/srs?secret=__HOOK_SECRET__;
    }
}
